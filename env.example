# Copy to .env for local runs:  set -a; source .env; set +a
# NEVER commit the real .env.  On Catalyst, set these in the AppSail console instead.
QUICKML_ENDPOINT_URL=https://...                # Deployment URL from QuickML > Endpoints
QUICKML_ENDPOINT_KEY=                           # Endpoint key from the same page
CATALYST_ORG_ID=                                # Catalyst organisation id (console > Settings)
CATALYST_ENVIRONMENT=Development                # or Production

ZOHO_CLIENT_ID=                                 # api-console.zoho.* > Self Client
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=                             # scope QuickML.deployment.READ
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in      # .com / .eu / .com.au / .jp ... must match your data centre

# optional
QUICKML_MODE=auto                               # auto | batch | single
QUICKML_FALLBACK=1                              # 0 = fail loudly instead of using the local model
QUICKML_TIMEOUT=30
